<?xml version="1.0" encoding="UTF-8"?>
<!--
  GitHub-hosted runners are periodically 403'd by Maven Central's CDN
  (Cloudflare treating Actions IP ranges as abuse). The GCS mirror of Central
  is a separate origin, so plugin resolution can still proceed when
  repo.maven.apache.org refuses the download.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>GCS Maven Central mirror</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
