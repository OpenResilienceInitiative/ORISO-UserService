  "customHttpTransports": [
    {
      "dependency": "Generated ORISO service clients and ordinary Matrix calls",
      "transport": "bounded Spring RestTemplate",
      "constructionSite": "src/main/java/de/caritas/cob/userservice/api/config/AppConfig.java"
    },
    {
      "dependency": "Matrix sync long-poll",
      "transport": "bounded Spring RestTemplate with long-poll read timeout",
      "constructionSite": "src/main/java/de/caritas/cob/userservice/api/config/AppConfig.java"
    },
    {
      "dependency": "Keycloak identity extensions",
      "transport": "bounded Spring RestTemplate",
      "constructionSite": "src/main/java/de/caritas/cob/userservice/api/adapters/keycloak/config/KeycloakConfig.java"
    },
    {
      "dependency": "Keycloak Admin API",
      "transport": "bounded pooled RESTEasy client with automatic retries disabled",
      "constructionSite": "src/main/java/de/caritas/cob/userservice/api/adapters/keycloak/config/KeycloakAdminClientTransport.java"
    }
  ],
  "stateAndEventInfrastructure": [
    {
      "dependency": "MariaDB",
      "transport": "JDBC"
    },
    {
      "dependency": "Redis",
      "transport": "Redis"
    },
    {
      "dependency": "RabbitMQ",
      "transport": "AMQP"
    }
  ],
  "absentRuntimeDependencies": [
    "Rocket.Chat",
    "Jitsi",
    "LiveService",
    "MessageService"
  ],
  "chattyCallReductions": [
    {
      "id": "consultant-agency-batch",
      "dependency": "AgencyService",
      "operation": "public consultant profile read",
      "bound": "one batched AgencyService call per consultant profile read",
      "runtimeProof": "scripts/load/run-seeded-public-read-replicas.sh"
    },
    {
      "id": "agency-matrix-technical-identity-grant",
      "dependency": "Keycloak",
      "operation": "technical authentication for internal AgencyService Matrix credential reads",
      "previousBehavior": "one password grant per new agency-held session",
      "currentBehavior": "one synchronized in-memory grant per UserService replica and token lifetime",
      "maxGrantsPerReplicaPerTokenLifetime": 1,
      "maxAuthRefreshRetriesPerCall": 1,
      "maxAgencyCredentialAttemptsPerSession": 2,
      "invalidateEveryUnauthorizedGrant": true,
      "parallelFullPathSessions": 64,
      "implementation": "src/main/java/de/caritas/cob/userservice/api/service/identity/TechnicalIdentityTokenProvider.java",
      "consumer": "src/main/java/de/caritas/cob/userservice/api/service/agency/AgencyMatrixCredentialClient.java",
      "fullPathContract": "src/test/java/de/caritas/cob/userservice/api/facade/CreateSessionTechnicalIdentityFanOutTest.java",
      "retryMetric": "userservice.outbound.retries{dependency=agency-service,operation=matrix-credentials-auth-refresh}"
    }
  ],
  "measurementPolicy": {
    "callAttempts": "userservice.outbound.http.calls",
    "latency": "userservice.outbound.http.latency",
    "payload": "userservice.outbound.http.payload",
    "explicitRetries": "userservice.outbound.retries",
    "applicationFallbacks": "userservice.dependency.fallbacks",
    "note": "Runtime call frequency and successful application fallbacks are measured from metrics and load evidence, not inferred from static source-expression counts."
  }
}
