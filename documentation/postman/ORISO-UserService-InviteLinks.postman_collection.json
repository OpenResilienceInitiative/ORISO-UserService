              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "X-CSRF-Bypass",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "CSRF-TOKEN={{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agencyId\": {{agencyId}},\n  \"topicId\": {{topicId}},\n  \"linkKind\": \"EXTERNAL_INBOUND\",\n  \"chatType\": \"LIVE_CHAT\",\n  \"anonymity\": \"FULL\",\n  \"notes\": \"Local Postman invite-link test\",\n  \"expiresInDays\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/useradmin/invitelinks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "useradmin",
                "invitelinks"
              ]
            },
            "description": "Creates a normal external inbound invite link. Saves the returned token to inviteToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create returns 201', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Create response contains token and active status', function () {",
                  "  pm.expect(body).to.have.property('token');",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.status).to.eql('ACTIVE');",
                  "  pm.expect(body.linkKind).to.eql('EXTERNAL_INBOUND');",
                  "  pm.expect(body.chatType).to.eql('LIVE_CHAT');",
                  "  pm.expect(body.anonymity).to.eql('FULL');",
                  "});",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('inviteToken', body.token);",
                  "  try { pm.environment.set('inviteToken', body.token); } catch (e) {}",
                  "}"
                ]
              }
            }
          ]
        },
