                "type": "text/javascript",
                "exec": [
                  "pm.test('Redeem returns 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Redeem response contains routing metadata', function () {",
                  "  pm.expect(body).to.have.property('tenantId');",
                  "  pm.expect(body).to.have.property('agencyId');",
                  "  pm.expect(body).to.have.property('consultingTypeId');",
                  "  pm.expect(body).to.have.property('topicId');",
                  "});"
                ]
              }
            }
          ]
        }
