            },
            "description": "Creates a counsellor-routed invite link. Requires consultantId to be set to a valid consultant in the same tenant."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Counsellor create returns 201 when consultantId is valid', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('inviteToken', body.token);",
                  "  try { pm.environment.set('inviteToken', body.token); } catch (e) {}",
                  "}"
                ]
              }
            }
          ]
        },
