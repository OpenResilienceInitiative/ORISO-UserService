{
  "info": {
    "_postman_id": "0e66fa94-ff53-4333-995d-4a96e8e18722",
    "name": "ORISO UserService - Invite Links",
    "description": "Local Postman collection for testing UserService invite-link APIs against a Java 21 local hybrid setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const defaults = {",
          "  baseUrl: 'http://localhost:8082',",
          "  keycloakBaseUrl: 'https://auth.oriso-dev.site',",
          "  realm: 'online-beratung',",
          "  clientId: 'app',",
          "  csrfToken: 'local-postman-csrf'",
          "};",
          "Object.keys(defaults).forEach(function (key) {",
          "  if (!pm.variables.get(key)) {",
          "    pm.collectionVariables.set(key, defaults[key]);",
          "  }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Route Check - Redeem Fake Token Should Return 404",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/invitelinks/not-a-real-token/redeem",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "invitelinks",
                "not-a-real-token",
                "redeem"
              ]
            },
            "description": "Confirms the local invite-link redeem route is reachable. A 404 means the endpoint exists and the fake token was not found."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Route is reachable and fake token is not found', function () {",
                  "  pm.expect(pm.response.code).to.eql(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthorized List Should Return 401",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/useradmin/invitelinks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "useradmin",
                "invitelinks"
              ]
            },
            "description": "Negative auth check. Admin list endpoint must reject calls without a bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing bearer token is rejected', function () {",
                  "  pm.expect(pm.response.code).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Admin Token - Password Grant",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "openid",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakBaseUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakBaseUrl}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Gets a Keycloak access token and saves it into adminToken. Use credentials from the same Keycloak realm that local UserService validates against."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token request succeeds', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Token response contains access_token', function () {",
                  "  pm.expect(body).to.have.property('access_token');",
                  "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (body.access_token) {",
                  "  pm.collectionVariables.set('adminToken', body.access_token);",
                  "  try { pm.environment.set('adminToken', body.access_token); } catch (e) {}",
                  "}",
                  "if (body.refresh_token) {",
                  "  pm.collectionVariables.set('refreshToken', body.refresh_token);",
                  "  try { pm.environment.set('refreshToken', body.refresh_token); } catch (e) {}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Admin Token Against Local List Endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/useradmin/invitelinks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "useradmin",
                "invitelinks"
              ]
            },
            "description": "Verifies that the saved adminToken is accepted by the local UserService. 200 means auth is correct; 403 means token is valid but missing required admin authority; 401 means token is missing/expired/wrong issuer."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token is accepted or role failure is explicit', function () {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
