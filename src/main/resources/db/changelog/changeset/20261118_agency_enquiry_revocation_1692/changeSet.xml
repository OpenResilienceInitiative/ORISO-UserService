<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">
  <changeSet id="20261118-agency-enquiry-revocation-1692" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="agency_enquiry_revocation_task"/></not>
    </preConditions>
    <createTable tableName="agency_enquiry_revocation_task">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="consultant_agency_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="consultant_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="agency_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="session_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="room_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="member_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="retry_at" type="DATETIME(6)"><constraints nullable="false"/></column>
    </createTable>
    <addUniqueConstraint tableName="agency_enquiry_revocation_task"
      columnNames="consultant_agency_id, session_id" constraintName="uk_enquiry_revocation_relation_session"/>
    <createIndex tableName="agency_enquiry_revocation_task" indexName="idx_enquiry_revocation_due">
      <column name="retry_at"/>
      <column name="id"/>
    </createIndex>
    <rollback><dropTable tableName="agency_enquiry_revocation_task"/></rollback>
  </changeSet>
</databaseChangeLog>
