<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
  <!--
    ORISO-Admin#1524: deleting a Beratungsstelle marks the sessions its advice seekers had there
    when those advice seekers keep their account because they also belong to another
    Beratungsstelle. The nightly deletion job purges marked sessions with their Matrix room.
    NULL = not marked. Additive and kept on application rollback.
  -->
  <changeSet id="20261124-session-delete-date-1524" author="oriso">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not><columnExists tableName="session" columnName="delete_date"/></not>
    </preConditions>
    <addColumn tableName="session">
      <column name="delete_date" type="datetime"/>
    </addColumn>
    <rollback><sql>SELECT 1</sql></rollback>
  </changeSet>
  <changeSet id="20261124-session-delete-date-index-1524" author="oriso">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not><indexExists tableName="session" indexName="idx_session_delete_date"/></not>
    </preConditions>
    <createIndex tableName="session" indexName="idx_session_delete_date">
      <column name="delete_date"/>
    </createIndex>
    <rollback><sql>SELECT 1</sql></rollback>
  </changeSet>
</databaseChangeLog>
