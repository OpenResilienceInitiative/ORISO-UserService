<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">
  <!-- ORISO-Frontend#1952: a conversation opened through a counsellor direct link (#1475,
       ADR-029) remembers the link's medium (CHAT / AUDIO / VIDEO), so the counsellor's list says
       "Videoanruf", "Audioanruf" or "Direktlink" instead of "Mail". Not a modality (ADR-006 keeps
       conversation_type); null for every other conversation, including all existing ones. -->
  <changeSet id="20261030-session-direct-link-medium-1952" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists tableName="session" columnName="direct_link_medium"/>
      </not>
    </preConditions>
    <addColumn tableName="session">
      <column name="direct_link_medium" type="VARCHAR(16)"/>
    </addColumn>
    <rollback>
      <dropColumn tableName="session" columnName="direct_link_medium"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
