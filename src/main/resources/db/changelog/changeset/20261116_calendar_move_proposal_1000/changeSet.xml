<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">
  <!-- ORISO-UserService#1000 (ADR-032, move proposals v1): a counsellor proposes a new time for a
       colleague's 1:1 appointment, and the colleague whose conversation it is decides. Times and
       references only. entry_start and entry_end keep the appointment's time when the proposal
       was made; a proposal goes with its appointment (the conversation's deletion cascades). -->
  <changeSet id="20261116-calendar-move-proposal-1000" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="calendar_move_proposal"/></not>
    </preConditions>
    <createTable tableName="calendar_move_proposal">
      <column name="id" type="CHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
      <column name="appointment_id" type="CHAR(36)"><constraints nullable="false"/></column>
      <column name="proposer_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="approver_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="proposed_start" type="DATETIME(6)"><constraints nullable="false"/></column>
      <column name="proposed_end" type="DATETIME(6)"><constraints nullable="false"/></column>
      <column name="entry_start" type="DATETIME(6)"><constraints nullable="false"/></column>
      <column name="entry_end" type="DATETIME(6)"><constraints nullable="false"/></column>
      <column name="status" type="VARCHAR(16)"><constraints nullable="false"/></column>
      <column name="created_at" type="DATETIME(6)"><constraints nullable="false"/></column>
      <column name="decided_at" type="DATETIME(6)"/>
    </createTable>
    <createIndex tableName="calendar_move_proposal"
      indexName="idx_calendar_move_proposal_approver">
      <column name="approver_id"/>
      <column name="status"/>
    </createIndex>
    <createIndex tableName="calendar_move_proposal"
      indexName="idx_calendar_move_proposal_proposer">
      <column name="proposer_id"/>
      <column name="status"/>
    </createIndex>
    <createIndex tableName="calendar_move_proposal"
      indexName="idx_calendar_move_proposal_appointment">
      <column name="appointment_id"/>
      <column name="status"/>
    </createIndex>
    <addForeignKeyConstraint baseTableName="calendar_move_proposal"
      baseColumnNames="appointment_id"
      referencedTableName="session_appointment" referencedColumnNames="id"
      constraintName="fk_calendar_move_proposal_appointment" onDelete="CASCADE"/>
    <rollback><dropTable tableName="calendar_move_proposal"/></rollback>
  </changeSet>
  <!-- MariaDB DDL does not roll back: a run that created the table but not all of its indexes or
       its foreign key would be marked as ran above and stay without them. These find that and
       repair it. The table's rollback removes them with it, so there is nothing to undo here. -->
  <changeSet id="20261116-calendar-move-proposal-1000-index-approver" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not>
        <indexExists tableName="calendar_move_proposal"
          indexName="idx_calendar_move_proposal_approver"/>
      </not>
    </preConditions>
    <createIndex tableName="calendar_move_proposal"
      indexName="idx_calendar_move_proposal_approver">
      <column name="approver_id"/>
      <column name="status"/>
    </createIndex>
    <rollback/>
  </changeSet>
  <changeSet id="20261116-calendar-move-proposal-1000-index-proposer" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not>
        <indexExists tableName="calendar_move_proposal"
          indexName="idx_calendar_move_proposal_proposer"/>
      </not>
    </preConditions>
    <createIndex tableName="calendar_move_proposal"
      indexName="idx_calendar_move_proposal_proposer">
      <column name="proposer_id"/>
      <column name="status"/>
    </createIndex>
    <rollback/>
  </changeSet>
  <changeSet id="20261116-calendar-move-proposal-1000-index-appointment" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not>
        <indexExists tableName="calendar_move_proposal"
          indexName="idx_calendar_move_proposal_appointment"/>
      </not>
    </preConditions>
    <createIndex tableName="calendar_move_proposal"
      indexName="idx_calendar_move_proposal_appointment">
      <column name="appointment_id"/>
      <column name="status"/>
    </createIndex>
    <rollback/>
  </changeSet>
  <changeSet id="20261116-calendar-move-proposal-1000-appointment-fk" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not>
        <foreignKeyConstraintExists foreignKeyTableName="calendar_move_proposal"
          foreignKeyName="fk_calendar_move_proposal_appointment"/>
      </not>
    </preConditions>
    <addForeignKeyConstraint baseTableName="calendar_move_proposal"
      baseColumnNames="appointment_id"
      referencedTableName="session_appointment" referencedColumnNames="id"
      constraintName="fk_calendar_move_proposal_appointment" onDelete="CASCADE"/>
    <rollback/>
  </changeSet>
</databaseChangeLog>
