 <changeSet id="20261021-identity-lifecycle-367-retry-fairness" author="codex">
  <comment>#367: reserve bounded due retry pages durably so unresolved cleanup cannot starve later activation.</comment>
  <sqlFile path="db/changelog/changeset/20261021_identity_lifecycle_367/retry-fairness.sql"
   relativeToChangelogFile="false" splitStatements="true" stripComments="true" endDelimiter=";"/>
