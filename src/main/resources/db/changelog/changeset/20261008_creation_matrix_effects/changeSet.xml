<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">
<changeSet id="20261008-creation-matrix-effects" author="oriso">
<createTable tableName="identity_creation_effect">
<column name="id" type="VARCHAR(36)"><constraints nullable="false" primaryKey="true"/></column>
<column name="attempt_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
<column name="account_id" type="VARCHAR(64)"><constraints nullable="false"/></column>
<column name="tenant_id" type="BIGINT"/>
<column name="execution_claim" type="VARCHAR(36)"><constraints nullable="false"/></column>
<column name="effect_kind" type="VARCHAR(32)"><constraints nullable="false"/></column>
<column name="state" type="VARCHAR(32)"><constraints nullable="false"/></column>
<column name="requested_target" type="VARCHAR(512)"><constraints nullable="false"/></column>
<column name="target_id" type="VARCHAR(512)"/>
<column name="provenance" type="VARCHAR(48)"/>
</createTable>
<createIndex tableName="identity_creation_effect" indexName="idx_creation_effect_attempt"><column name="attempt_id"/></createIndex>
<rollback><dropTable tableName="identity_creation_effect"/></rollback>
</changeSet>
</databaseChangeLog>
