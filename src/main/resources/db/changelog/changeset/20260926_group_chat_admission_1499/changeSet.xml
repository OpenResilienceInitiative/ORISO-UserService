<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">
  <changeSet id="20260926-group-chat-admission-1499" author="oriso">
    <addColumn tableName="group_chat_join_request">
      <column name="admission_requested_at" type="datetime"/>
      <column name="admission_attempt_count" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="admission_last_attempt_at" type="datetime"/>
    </addColumn>
    <rollback>
      <dropColumn tableName="group_chat_join_request" columnName="admission_last_attempt_at"/>
      <dropColumn tableName="group_chat_join_request" columnName="admission_attempt_count"/>
      <dropColumn tableName="group_chat_join_request" columnName="admission_requested_at"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
