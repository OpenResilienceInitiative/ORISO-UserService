<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">
  <!-- ORISO-UserService#1000 (ADR-032, contract addendum v1.2): a counsellor's working hours on
       single dates. One row per working window of local wall-clock time on exception_date; a
       whole day off is one row with neither start_time nor end_time. Display only: booking, the
       subscription feed and the busy import do not read this table. Table and index are separate
       changesets, each guarded, so a table made by hand still gets its index. -->
  <changeSet id="20261114-calendar-working-day-exception-1000" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="calendar_working_day_exception"/>
      </not>
    </preConditions>
    <createTable tableName="calendar_working_day_exception">
      <column name="id" type="CHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
      <column name="consultant_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="exception_date" type="DATE"><constraints nullable="false"/></column>
      <column name="start_time" type="TIME"/>
      <column name="end_time" type="TIME"/>
    </createTable>
    <rollback><dropTable tableName="calendar_working_day_exception"/></rollback>
  </changeSet>
  <!-- The table's rollback removes the index with it, so there is nothing to undo here. -->
  <changeSet id="20261114-calendar-working-day-exception-index-1000" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not>
        <indexExists tableName="calendar_working_day_exception"
          indexName="idx_calendar_working_day_exception_consultant_date"/>
      </not>
    </preConditions>
    <createIndex tableName="calendar_working_day_exception"
      indexName="idx_calendar_working_day_exception_consultant_date">
      <column name="consultant_id"/>
      <column name="exception_date"/>
    </createIndex>
    <rollback/>
  </changeSet>
  <!-- One row per counsellor for the settings of their working hours that are no window: the
       Bundesland whose public holidays count as days off (ISO 3166-2:DE suffix, e.g. BY), null
       when holidays are not days off. The server computes no holidays; it only keeps the
       region. -->
  <changeSet id="20261114-calendar-working-hours-setting-1000" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="calendar_working_hours_setting"/>
      </not>
    </preConditions>
    <createTable tableName="calendar_working_hours_setting">
      <column name="consultant_id" type="VARCHAR(36)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="holiday_region" type="VARCHAR(2)"/>
    </createTable>
    <rollback><dropTable tableName="calendar_working_hours_setting"/></rollback>
  </changeSet>
</databaseChangeLog>
