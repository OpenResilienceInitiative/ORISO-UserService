<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">
  <!-- ORISO-UserService#1000 (ADR-032, contract addendum v1.1): a counsellor's working hours, one
       row per weekly window of local wall-clock time in the platform's zone (weekday 0 = Sunday
       .. 6 = Saturday). Display only: booking, the subscription feed and the busy import do not
       read this table. -->
  <changeSet id="20261114-calendar-working-hours-1000" author="oriso">
    <createTable tableName="calendar_working_hours">
      <column name="id" type="CHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
      <column name="consultant_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="weekday" type="INT"><constraints nullable="false"/></column>
      <column name="start_time" type="TIME"><constraints nullable="false"/></column>
      <column name="end_time" type="TIME"><constraints nullable="false"/></column>
    </createTable>
    <createIndex tableName="calendar_working_hours"
      indexName="idx_calendar_working_hours_consultant">
      <column name="consultant_id"/>
    </createIndex>
    <rollback><dropTable tableName="calendar_working_hours"/></rollback>
  </changeSet>
</databaseChangeLog>
