<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">
  <changeSet id="20261121-support-room-creation-intent-904" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="support_room_creation_intent"/></not>
    </preConditions>
    <createTable tableName="support_room_creation_intent">
      <column name="handshake_id" type="VARCHAR(36)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="id" type="VARCHAR(36)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_support_room_creation_id"/>
      </column>
      <column name="nonce" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="support_admin_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="support_admin_matrix_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="consultant_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="consultant_matrix_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="tenant_id" type="BIGINT"/>
      <column name="expires_at" type="DATETIME(6)"><constraints nullable="false"/></column>
      <column name="retry_at" type="DATETIME(6)"><constraints nullable="false"/></column>
    </createTable>
    <!-- Pending creations must survive a rollback. -->
    <rollback/>
  </changeSet>
  <changeSet id="20261121-support-room-creation-intent-retry-904" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><indexExists tableName="support_room_creation_intent" indexName="idx_support_room_creation_retry"/></not>
    </preConditions>
    <createIndex tableName="support_room_creation_intent" indexName="idx_support_room_creation_retry">
      <column name="retry_at"/>
      <column name="handshake_id"/>
    </createIndex>
    <rollback/>
  </changeSet>
  <changeSet id="20261121-support-room-provisioning-deadline-904" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="support_room_creation_intent" columnName="provisioning_deadline"/></not>
    </preConditions>
    <addColumn tableName="support_room_creation_intent">
      <column name="provisioning_deadline" type="DATETIME(6)"/>
    </addColumn>
    <!-- Preserve an attempt's deadline if an older service image is restored. -->
    <rollback/>
  </changeSet>
  <changeSet id="20261121-support-room-recovery-backoff-904" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="support_room_creation_intent" columnName="recovery_probe_failures"/></not>
    </preConditions>
    <addColumn tableName="support_room_creation_intent">
      <column name="recovery_probe_failures" type="INT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>
    <!-- Preserve recovery progress across image rollback. -->
    <rollback/>
  </changeSet>
</databaseChangeLog>
