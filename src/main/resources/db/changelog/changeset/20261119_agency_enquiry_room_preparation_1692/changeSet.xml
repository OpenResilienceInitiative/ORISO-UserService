<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">
  <changeSet id="20261119-agency-enquiry-room-opening-status-1692" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="agency_enquiry_room_decision" columnName="opening_status"/></not>
    </preConditions>
    <addColumn tableName="agency_enquiry_room_decision">
      <column name="opening_status" type="VARCHAR(32)"/>
    </addColumn>
    <rollback><dropColumn tableName="agency_enquiry_room_decision" columnName="opening_status"/></rollback>
  </changeSet>
  <changeSet id="20261119-agency-enquiry-room-prepared-until-1692" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="agency_enquiry_room_decision" columnName="prepared_until"/></not>
    </preConditions>
    <addColumn tableName="agency_enquiry_room_decision">
      <column name="prepared_until" type="DATETIME(6)"/>
    </addColumn>
    <rollback><dropColumn tableName="agency_enquiry_room_decision" columnName="prepared_until"/></rollback>
  </changeSet>
  <changeSet id="20261119-agency-enquiry-room-expired-selection-1692" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><indexExists tableName="agency_enquiry_room_decision" indexName="idx_enquiry_room_prepared_until"/></not>
    </preConditions>
    <createIndex tableName="agency_enquiry_room_decision" indexName="idx_enquiry_room_prepared_until">
      <column name="prepared_until"/>
      <column name="id"/>
    </createIndex>
    <rollback><dropIndex tableName="agency_enquiry_room_decision" indexName="idx_enquiry_room_prepared_until"/></rollback>
  </changeSet>
</databaseChangeLog>
