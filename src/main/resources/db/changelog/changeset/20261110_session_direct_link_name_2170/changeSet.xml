<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">
  <!-- ORISO-Frontend#2170: a conversation opened through a counsellor direct link (#1475, ADR-029)
       remembers the link's name ("Flyer Schule"), so its call is called that instead of
       "Group call for <room id>". The name is a snapshot like direct_link_medium: the conversation
       keeps no reference to the link. VARCHAR(100) is CounsellorDirectLinkService.NAME_MAX. Null
       for every other conversation, including all existing ones. -->
  <changeSet id="20261110-session-direct-link-name-2170" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists tableName="session" columnName="direct_link_name"/>
      </not>
    </preConditions>
    <addColumn tableName="session">
      <column name="direct_link_name" type="VARCHAR(100)"/>
    </addColumn>
    <!-- Keep the column on rollback. Liquibase also runs this rollback when the changeset was
         only MARK_RAN because the column already existed, and a drop would then erase names this
         changeset never created. The column is nullable and additive, so an older application
         simply ignores it (same rule as 20261108_protected_draft_scope). -->
    <rollback><sql>SELECT 1</sql></rollback>
  </changeSet>
</databaseChangeLog>
