<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">
  <changeSet id="20261119-agency-enquiry-room-event-order-1692" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><sequenceExists sequenceName="sequence_enquiry_room_event"/></not>
    </preConditions>
    <sql>CREATE SEQUENCE sequence_enquiry_room_event NOCACHE NOCYCLE</sql>
    <rollback><dropSequence sequenceName="sequence_enquiry_room_event"/></rollback>
  </changeSet>
  <changeSet id="20261119-agency-enquiry-room-decision-1692" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="agency_enquiry_room_decision"/></not>
    </preConditions>
    <createTable tableName="agency_enquiry_room_decision">
      <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
      <column name="session_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="agency_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="room_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="ownership_revision" type="BIGINT"><constraints nullable="false"/></column>
      <column name="outcome" type="VARCHAR(10)"><constraints nullable="false"/></column>
      <column name="resolved_order" type="BIGINT"/>
    </createTable>
    <rollback><dropTable tableName="agency_enquiry_room_decision"/></rollback>
  </changeSet>
  <changeSet id="20261119-agency-enquiry-room-decision-revision-1692" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><indexExists tableName="agency_enquiry_room_decision" indexName="uk_enquiry_room_decision_revision"/></not>
    </preConditions>
    <createIndex tableName="agency_enquiry_room_decision" indexName="uk_enquiry_room_decision_revision" unique="true">
      <column name="session_id"/>
      <column name="ownership_revision"/>
    </createIndex>
    <rollback><dropIndex tableName="agency_enquiry_room_decision" indexName="uk_enquiry_room_decision_revision"/></rollback>
  </changeSet>
  <changeSet id="20261119-agency-enquiry-room-departure-lookup-1692" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><indexExists tableName="agency_enquiry_room_decision" indexName="idx_enquiry_room_decision_departure"/></not>
    </preConditions>
    <createIndex tableName="agency_enquiry_room_decision" indexName="idx_enquiry_room_decision_departure">
      <column name="tenant_id"/>
      <column name="agency_id"/>
      <column name="outcome"/>
      <column name="resolved_order"/>
    </createIndex>
    <rollback><dropIndex tableName="agency_enquiry_room_decision" indexName="idx_enquiry_room_decision_departure"/></rollback>
  </changeSet>
  <changeSet id="20261119-agency-enquiry-revocation-decision-1692" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="agency_enquiry_revocation_task" columnName="room_decision_id"/></not>
    </preConditions>
    <addColumn tableName="agency_enquiry_revocation_task">
      <column name="room_decision_id" type="BIGINT"/>
    </addColumn>
    <rollback>
      <delete tableName="agency_enquiry_revocation_task">
        <where>room_decision_id IS NOT NULL AND retry_at = '9999-12-31 00:00:00'</where>
      </delete>
      <dropColumn tableName="agency_enquiry_revocation_task" columnName="room_decision_id"/>
    </rollback>
  </changeSet>
  <changeSet id="20261119-agency-enquiry-revocation-decision-lookup-1692" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><indexExists tableName="agency_enquiry_revocation_task" indexName="idx_enquiry_revocation_decision"/></not>
    </preConditions>
    <createIndex tableName="agency_enquiry_revocation_task" indexName="idx_enquiry_revocation_decision">
      <column name="room_decision_id"/>
    </createIndex>
    <rollback><dropIndex tableName="agency_enquiry_revocation_task" indexName="idx_enquiry_revocation_decision"/></rollback>
  </changeSet>
</databaseChangeLog>
